{
  "name": "daftar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source, offline accounting for small businesses (QuickBooks Desktop-style workflows).",
  "author": "Zaid Alhawamdeh Technology",
  "main": "desktop/main.cjs",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"core/**/*.test.ts\" \"catalog/**/*.test.ts\" \"store/**/*.test.ts\" \"app/**/*.test.ts\"",
    "typecheck": "tsc -p . && tsc -p app",
    "parity": "node scripts/parity.ts",
    "check": "npm run typecheck && npm test && node scripts/parity.ts --check",
    "dev": "vite app",
    "build": "vite build app",
    "screenshots": "vite build app && node scripts/screenshots.ts",
    "icon": "node scripts/icon.ts",
    "desktop": "vite build app && electron .",
    "dist:win": "vite build app && electron-builder --win nsis"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.19.2",
    "electron": "43.7.7",
    "electron-builder": "26.16.1",
    "playwright-core": "1.62.0",
    "typescript": "^5.9.3",
    "vite": "6.4.5"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "build": {
    "appId": "com.zaidalhawamdeh.daftar",
    "productName": "Daftar",
    "copyright": "Copyright © 2026 Zaid Alhawamdeh Technology",
    "directories": {
      "output": "release",
      "buildResources": "desktop"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daftar",
      "artifactName": "Daftar-Setup-${version}.${ext}",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "ar_SA"
      ]
    }
  }
}
